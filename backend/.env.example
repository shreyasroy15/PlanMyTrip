# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/planmytrip

# JWT Security Keys (Use strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRES_MINUTES=5

# Transactional Email (SMTP Configuration)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM_NAME="PlanMyTrip AI"
EMAIL_FROM_ADDRESS="no-reply@planmytrip.com"

# Google Sign-In OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Apple Sign-In
APPLE_CLIENT_ID=com.planmytrip.app
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID

# Phone OTP / SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
